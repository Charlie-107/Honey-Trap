{
  "manifest_version": 3,
  "name": "IoT Security Auditor",
  "version": "2.0.0",
  "description": "Dual-mode cybersecurity auditor: active-tab Website Security Scanning and dynamic IoT Network Anomaly Detection (OWASP IoT Top 10 + Rust/Wasm SHAP).",

  "action": {
    "default_popup": "popup.html",
    "default_title": "IoT Security Auditor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "pkg/*.wasm",
        "pkg/*.js",
        "content.css",
        "dashboard.html",
        "export-utils.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
